{
  "system_id": "osa_ak",
  "status": "Placeholder layout (SAM3D design). Seats, panels and positions are not from any source and only need to be reachable and readable; replace them when real cabin references or the creator's panel art are available. Lamp meanings follow the SAM Simulator manual where it gives them.",
  "notes": "Body frame: metres, x right, y forward, z up, from the ground under the hull centre. The placeholder hull in Unreal is 9.1 x 2.8 m with its roof at 2.2 m. Lamp sources use the source ids of data/procedures/osa_ak.json.",

  "stations": [
    { "id": "driver", "label": "Driver", "eye_m": [-0.65, 3.6, 1.55], "yaw_deg": 0, "pitch_deg": -15 },
    { "id": "commander", "label": "Commander", "eye_m": [0.65, 3.6, 1.55], "yaw_deg": 0, "pitch_deg": -15 },
    { "id": "range_officer", "label": "Range officer", "eye_m": [-0.35, 1.9, 1.5], "yaw_deg": -90, "pitch_deg": -10 },
    { "id": "firing_officer", "label": "Firing officer", "eye_m": [0.35, 1.9, 1.5], "yaw_deg": 90, "pitch_deg": -10 }
  ],

  "panels": [
    { "id": "driver_panel", "label": "Driver", "station": "driver",
      "centre_m": [-0.65, 4.2, 1.25], "facing_deg": 180, "tilt_deg": 30, "size_m": [0.5, 0.3] },
    { "id": "commander_panel", "label": "Commander", "station": "commander",
      "centre_m": [0.65, 4.2, 1.25], "facing_deg": 180, "tilt_deg": 30, "size_m": [0.7, 0.3] },
    { "id": "ro_panel", "label": "SOC / SSC (range officer)", "station": "range_officer",
      "centre_m": [-1.0, 1.9, 1.4], "facing_deg": 90, "tilt_deg": 15, "size_m": [1.1, 0.9] },
    { "id": "fo_panel", "label": "SSC elevation / TOV / launch (firing officer)", "station": "firing_officer",
      "centre_m": [1.0, 1.9, 1.4], "facing_deg": -90, "tilt_deg": 15, "size_m": [1.1, 0.9] }
  ],

  "controls": [
    { "control": "pwr.pto", "panel": "driver_panel", "at_m": [0.0, 0.05] },

    { "control": "pwr.gta", "panel": "commander_panel", "at_m": [-0.25, 0.05] },
    { "control": "apu.lock", "panel": "commander_panel", "at_m": [-0.1, 0.05] },
    { "control": "apu.stow", "panel": "commander_panel", "at_m": [0.05, 0.05] },

    { "control": "soc.search", "panel": "ro_panel", "at_m": [-0.42, 0.06] },
    { "control": "soc.hv", "panel": "ro_panel", "at_m": [-0.3, 0.06] },
    { "control": "soc.range", "panel": "ro_panel", "at_m": [-0.17, 0.06] },
    { "control": "soc.beam", "panel": "ro_panel", "at_m": [-0.03, 0.06] },
    { "control": "soc.mti", "panel": "ro_panel", "at_m": [0.1, 0.06] },
    { "control": "ssc.tx", "panel": "ro_panel", "at_m": [-0.42, -0.1] },
    { "control": "ssc.mti", "panel": "ro_panel", "at_m": [-0.3, -0.1] },
    { "control": "ssc.az_light", "panel": "ro_panel", "at_m": [-0.18, -0.1] },
    { "control": "ssc.az_lock", "panel": "ro_panel", "at_m": [-0.06, -0.1] },
    { "control": "ro.semi_auto", "panel": "ro_panel", "at_m": [0.08, -0.1] },
    { "control": "ssc.az_wheel", "panel": "ro_panel", "at_m": [-0.25, -0.3], "units_per_turn": 60,
      "notes": "One turn of the hand wheel = 60 degrees of azimuth (SAM3D estimate, for playability)." },
    { "control": "ssc.range_wheel", "panel": "ro_panel", "at_m": [0.1, -0.3], "units_per_turn": 5000,
      "notes": "SAM3D estimate, for playability. The wheel's unit is in data/procedures/osa_ak.json." },

    { "control": "tov.power", "panel": "fo_panel", "at_m": [-0.42, 0.06] },
    { "control": "tov.fov", "panel": "fo_panel", "at_m": [-0.3, 0.06] },
    { "control": "fo.mode", "panel": "fo_panel", "at_m": [-0.18, 0.06] },
    { "control": "fo.bort_spk", "panel": "fo_panel", "at_m": [-0.06, 0.06] },
    { "control": "fo.pomekha", "panel": "fo_panel", "at_m": [0.06, 0.06] },
    { "control": "fo.ru", "panel": "fo_panel", "at_m": [-0.42, -0.1] },
    { "control": "fo.cu_az", "panel": "fo_panel", "at_m": [-0.3, -0.1] },
    { "control": "fo.pa", "panel": "fo_panel", "at_m": [-0.18, -0.1] },
    { "control": "ssc.el_light", "panel": "fo_panel", "at_m": [-0.06, -0.1] },
    { "control": "ssc.el_lock", "panel": "fo_panel", "at_m": [0.06, -0.1] },
    { "control": "ssc.el_wheel", "panel": "fo_panel", "at_m": [-0.25, -0.3], "units_per_turn": 20,
      "notes": "One turn = 20 degrees of elevation (SAM3D estimate, for playability)." },
    { "control": "fo.key", "panel": "fo_panel", "at_m": [0.06, -0.3] },
    { "control": "fo.launch", "panel": "fo_panel", "at_m": [0.18, -0.3] }
  ],

  "lamps": [
    { "id": "pto_on", "label": "generator on line", "panel": "driver_panel", "at_m": [0.0, -0.08], "color": "green",
      "lit_when": [ { "subsystem": "pto_generator", "is": "ready" } ],
      "source": "sam3d", "confidence": "estimate", "notes": "No source for this lamp; shows the subsystem state." },
    { "id": "gta_on", "label": "ГТА running", "panel": "commander_panel", "at_m": [-0.25, -0.08], "color": "green",
      "lit_when": [ { "subsystem": "gta", "is": "ready" } ],
      "source": "sam3d", "confidence": "estimate", "notes": "No source for this lamp; shows the subsystem state." },
    { "id": "apu_free", "label": "АПУ unlocked", "panel": "commander_panel", "at_m": [-0.1, -0.08], "color": "amber",
      "lit_when": [ { "subsystem": "apu_free", "is": "ready" } ],
      "source": "sam3d", "confidence": "estimate", "notes": "No source for this lamp; shows the subsystem state." },
    { "id": "antenna_up", "label": "search antenna raised", "panel": "commander_panel", "at_m": [0.05, -0.08], "color": "green",
      "lit_when": [ { "subsystem": "search_antenna", "is": "ready" } ],
      "source": "sam3d", "confidence": "estimate", "notes": "No source for this lamp; shows the subsystem state." },
    { "id": "power_on", "label": "power", "panel": "commander_panel", "at_m": [0.25, 0.05], "color": "green",
      "lit_when": [ { "subsystem": "power", "is": "ready" } ],
      "source": "sam3d", "confidence": "estimate", "notes": "No source for this lamp; shows the subsystem state." },
    { "id": "fault", "label": "equipment fault", "panel": "commander_panel", "at_m": [0.25, -0.08], "color": "red",
      "lit_when_any": [ { "subsystem": "gta", "is": "fault" }, { "subsystem": "pto_generator", "is": "fault" },
                        { "subsystem": "apu_free", "is": "fault" }, { "subsystem": "search_antenna", "is": "fault" } ],
      "source": "sam3d", "confidence": "estimate", "notes": "No source for this lamp; tells the commander something faulted (e.g. driving with the АПУ unlocked)." },

    { "id": "tsc", "label": "ТСЦ", "panel": "ro_panel", "at_m": [0.3, 0.06], "color": "green",
      "lit_when": [ { "subsystem": "auto_tracking", "is": "ready" } ],
      "source": "samsim_osa p24", "confidence": "medium", "notes": "Angle tracking lamp. The console models angle and range tracking as one subsystem." },
    { "id": "avtomat", "label": "АВТОМАТ", "panel": "ro_panel", "at_m": [0.42, 0.06], "color": "green",
      "lit_when": [ { "subsystem": "auto_tracking", "is": "ready" } ],
      "source": "samsim_osa p24", "confidence": "medium", "notes": "Range tracking lamp; same subsystem as ТСЦ." },

    { "id": "vnimanie", "label": "ВНИМАНИЕ", "panel": "fo_panel", "at_m": [0.3, 0.06], "color": "amber",
      "lit_when": [ { "input": "target_near_zone", "is": true } ],
      "source": "samsim_osa p29", "confidence": "high", "notes": "Colour: sam3d estimate." },
    { "id": "in_zone", "label": "ЦЕЛЬ В ЗОНЕ", "panel": "fo_panel", "at_m": [0.42, 0.06], "color": "green",
      "lit_when": [ { "input": "target_in_zone", "is": true } ],
      "source": "samsim_osa p29", "confidence": "high", "notes": "Colour: sam3d estimate." },
    { "id": "zakhvat", "label": "ЗАХВАТ", "panel": "fo_panel", "at_m": [0.3, -0.1], "color": "green",
      "lit_when_any": [ { "subsystem": "missile_prep", "is": "starting" }, { "subsystem": "missile_prep", "is": "ready" } ],
      "source": "samsim_osa p18, p29", "confidence": "low",
      "notes": "First lamp of missile preparation. The console has one missile_prep subsystem, so this lights as soon as preparation starts." },
    { "id": "vkl_vys", "label": "ВКЛ ВЫС", "panel": "fo_panel", "at_m": [0.42, -0.1], "color": "green",
      "lit_when": [ { "subsystem": "missile_prep", "is": "ready" } ],
      "source": "samsim_osa p18, p29", "confidence": "low",
      "notes": "Lights when preparation is done in this model; the real intermediate stage isn't modelled." },
    { "id": "pusk_gotov", "label": "ПУСК ГОТОВ", "panel": "fo_panel", "at_m": [0.3, -0.24], "color": "green",
      "lit_when": [ { "subsystem": "launch_armed", "is": "ready" } ],
      "source": "samsim_osa p29–30", "confidence": "medium" },
    { "id": "nlc", "label": "НЛЦ", "panel": "fo_panel", "at_m": [0.42, -0.24], "color": "red",
      "lit_when": [ { "input": "target_too_low", "is": true } ],
      "source": "samsim_osa p25", "confidence": "high", "notes": "Panel and colour: sam3d estimate." }
  ],

  "displays": [
    { "id": "soc_ppi", "label": "SOC indicator", "kind": "ppi", "panel": "ro_panel", "at_m": [-0.3, 0.28], "size_m": [0.28, 0.28],
      "on_when": [ { "subsystem": "power", "is": "ready" } ],
      "sweep_period_s": 2.0, "afterglow_s": 3.0,
      "source": "samsim_osa p15, p21-22", "confidence": "medium",
      "notes": "Search picture up to 45 km on the selected scale, with the SSC azimuth line and range gate the operator puts on the target mark (p22). Sweep period, afterglow, the 10-45 km scale drawn as a delayed sweep (centre = 10 km), the clutter disc and the gate marker are SAM3D estimates." },
    { "id": "ssc_range", "label": "Range indicator", "kind": "range_scope", "panel": "ro_panel", "at_m": [0.12, 0.3], "size_m": [0.3, 0.2],
      "on_when": [ { "subsystem": "power", "is": "ready" } ],
      "magnified_window_m": 1500,
      "source": "samsim_osa p24", "confidence": "high",
      "notes": "Two sweeps: the upper shows 0-28 km with the target as a spike, the lower a 1.5 km magnification around the range gates. The counter shows the range wheel (p24 item 2)." },
    { "id": "beta_c", "label": "βс", "kind": "dial", "panel": "ro_panel", "at_m": [0.42, 0.3], "size_m": [0.14, 0.14],
      "control": "ssc.az_wheel", "marks": 12, "value_per_turn": 360, "labels_per_turn": 60,
      "on_when": [ { "subsystem": "power", "is": "ready" } ],
      "lit_when": [ { "control": "ssc.az_light", "is": 1 } ],
      "source": "samsim_osa p16", "confidence": "high",
      "notes": "SSC azimuth in Russian military angle (60-00 = 360 deg); ПОДСВЕТКА lights it. Dial face: SAM3D estimate." },

    { "id": "tov_monitor", "label": "TOV monitor", "kind": "tv", "panel": "fo_panel", "at_m": [-0.25, 0.28], "size_m": [0.32, 0.24],
      "on_when": [ { "subsystem": "tov_camera", "is": "ready" } ],
      "source": "samsim_osa p17, p25, p33-35", "confidence": "high",
      "notes": "The camera looks along the SSC azimuth and elevation with the wide or narrow lens; crosshair at the centre." },
    { "id": "epsilon_c", "label": "εс", "kind": "dial", "panel": "fo_panel", "at_m": [0.05, 0.3], "size_m": [0.14, 0.14],
      "control": "ssc.el_wheel", "marks": 12, "value_per_turn": 360, "labels_per_turn": 60,
      "on_when": [ { "subsystem": "power", "is": "ready" } ],
      "lit_when": [ { "control": "ssc.el_light", "is": 1 } ],
      "source": "samsim_osa p17", "confidence": "high",
      "notes": "SSC elevation in Russian military angle (15-00 = 90 deg); ПОДСВЕТКА lights it. Dial face: SAM3D estimate." },
    { "id": "dts_voltmeter", "label": "ДЦ", "kind": "meter", "panel": "fo_panel", "at_m": [0.27, 0.3], "size_m": [0.2, 0.14],
      "control": "ssc.range_wheel", "marks": 6, "scale": 0.001, "full_scale": 30, "unit": "V",
      "on_when_any": [ { "subsystem": "auto_tracking", "is": "ready" }, { "subsystem": "range_semi_auto", "is": "ready" } ],
      "source": "samsim_osa p29", "confidence": "medium",
      "notes": "Measured target distance, 10 V = 10 km. Reads while the SSC tracks in range (the range wheel follows the target then); rests at 0 otherwise. Full scale 30 V: SAM3D estimate." }
  ]
}
