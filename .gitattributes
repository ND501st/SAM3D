# Normalise text line endings; keep scripts in their native endings.
* text=auto
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# ---------- Git LFS: Unreal assets ----------
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text

# ---------- Git LFS: 3D source files ----------
*.blend  filter=lfs diff=lfs merge=lfs -text
