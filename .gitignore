# Cesium for Unreal keeps the ion access token here: never commit it.
unreal/**/Content/CesiumSettings/

# ---------- IDEs ----------
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.user
.DS_Store
Thumbs.db

# ---------- C++ / CMake ----------
build/
out/
cmake-build-*/
CMakeUserPresets.json

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# ---------- Generated sim output ----------
*.acmi
*.zip.acmi

# ---------- Original SAM Simulator files ----------
# The creator's game, art and data stay OUT of git (size + his copyright).
reference/*
!reference/README.md

# ---------- Reverse-engineering workspaces ----------
*.gpr
*.rep/
ghidra_projects/

# ---------- Claude Code local settings ----------
.claude/settings.local.json

# Cesium for Unreal request cache (local, regenerated)
unreal/**/cesium-request-cache.sqlite*
# Unreal's per-user scratch folder in Content
unreal/**/Content/Developers/

# Blender backups
*.blend1

# Deep-research working folders (the report is copied into docs/research)
research_notes/
reports/

# Third-party art (docs/scenery/ASSETS.md, data/scenery/assets.json): fetched per machine, never committed
# (licences such as Fab's Standard one forbid redistributing the files). tools/check_assets.py checks it.
unreal/**/Content/ThirdParty/
art/thirdparty/
# Packs Fab and the Procedural Vegetation Editor install at the Content root (their own folder names).
unreal/**/Content/Fab/
unreal/**/Content/GV_FreeShrubsPack/
unreal/**/Content/Megaplant_Library/
