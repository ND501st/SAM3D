root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Unreal code uses tabs (Epic's coding standard); simcore uses spaces.
[unreal/**.{h,cpp,cs}]
indent_style = tab

[*.{json,yml,yaml,uproject}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
